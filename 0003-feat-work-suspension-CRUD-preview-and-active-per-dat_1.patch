+      expect(preview.map((p) => [p.scheduleId, p.suspendedMinutes, p.fraction])).toEqual([
+        ['s1', 60, 0.125],
+        ['s2', 120, 0.25],
+      ]);
+    });
+
+    it('legacy hours: 0 when none, value for LEGACY rows only', async () => {
